# Supabase Configuration
VITE_SUPABASE_URL=your_supabase_url
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key
VITE_SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Monnify Configuration (Replace with your actual keys)
VITE_MONNIFY_API_KEY=your_monnify_api_key
VITE_MONNIFY_SECRET_KEY=your_monnify_secret_key
VITE_MONNIFY_CONTRACT_CODE=your_monnify_contract_code

# Resend Configuration
VITE_RESEND_API_KEY=your_resend_api_key

# Site URL (update for production)
VITE_SITE_URL=http://localhost:5173

# Cloudflare Turnstile
VITE_TURNSTILE_SITE_KEY=your_turnstile_site_key_here

# Supabase Functions Configuration
# When calling functions directly, ensure your Supabase project is properly set up
# and functions are deployed using: supabase functions deploy <function-name>