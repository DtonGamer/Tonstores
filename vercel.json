{
  "version": 2,
  "framework": "vite",
  "builds": [
    {
      "src": "package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "dist"
      }
    }
  ],
  "routes": [
    {
      "src": "/api/paystack-webhook",
      "dest": "https://hhxpuadernawdgdrdnok.supabase.co/functions/v1/paystack-webhook",
      "methods": ["POST", "GET"]
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ],
  "env": {
    "NODE_VERSION": "24.x"
  }
}